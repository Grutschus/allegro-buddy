{
 "name": "completion-install-bash-no-rc",
 "category": "completion",
 "argv": [
  "completion",
  "--install"
 ],
 "then": [],
 "world": "demo",
 "tweak": false,
 "env": {
  "COLUMNS": "100",
  "SHELL": "/bin/bash"
 },
 "stdin": null,
 "tty": "pipe",
 "files": [],
 "capture": [
  "home/.bashrc",
  "home/.local/share/allegro-buddy/completion-bab.bash"
 ],
 "sigint_after": null,
 "path_without_slurm": false,
 "normalize": []
}
