{
 "name": "completion-install-zsh-twice",
 "category": "completion",
 "argv": [
  "completion",
  "zsh",
  "--install"
 ],
 "then": [
  [
   "completion",
   "zsh",
   "--install"
  ]
 ],
 "world": "demo",
 "tweak": false,
 "env": {
  "COLUMNS": "100"
 },
 "stdin": null,
 "tty": "pipe",
 "files": [
  "home/.zshrc"
 ],
 "capture": [
  "home/.zshrc",
  "home/.local/share/allegro-buddy/completion-bab.zsh"
 ],
 "sigint_after": null,
 "path_without_slurm": false,
 "normalize": []
}
