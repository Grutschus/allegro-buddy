{
 "name": "completion-install-fish-no-xdg",
 "category": "completion",
 "argv": [
  "completion",
  "fish",
  "--install"
 ],
 "then": [],
 "world": "demo",
 "tweak": false,
 "env": {
  "COLUMNS": "100",
  "XDG_CONFIG_HOME": null
 },
 "stdin": null,
 "tty": "pipe",
 "files": [],
