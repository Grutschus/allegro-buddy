#!/bin/sh
# Replay fake Slurm: serves recorded outputs (see build.py). Symlinked as squeue,
# scontrol, sinfo, sacct, sacctmgr, ... Looks the exact argv up in $REPLAY_RUN/index.sh
# (the calls of one recorded command), then in $REPLAY_COMMON/index.sh (fallback: first
# recording of every argv). Unknown argv: exit 1 and log "MISS". Every call is appended
# to $REPLAY_LOG (if set) as "<run|common|MISS><TAB><argv joined by spaces>".
key="${0##*/} $*"
for d in "$REPLAY_RUN" "$REPLAY_COMMON"; do
    [ -n "$d" ] || continue
    n=
    . "$d/index.sh"
    [ -n "$n" ] || continue
    [ -z "$REPLAY_LOG" ] || printf '%s\t%s\n' "${d##*/}" "$key" >>"$REPLAY_LOG"
    if [ -n "$x" ]; then
        [ -z "$o" ] || cat "$d/$n.out"
        cat "$d/$n.err" >&2
        exit "$e"
    fi
    [ "$e" = 0 ] && [ -n "$o" ] && exec cat "$d/$n.out"
    [ -z "$o" ] || cat "$d/$n.out"
    exit "$e"
done
[ -z "$REPLAY_LOG" ] || printf 'MISS\t%s\n' "$key" >>"$REPLAY_LOG"
echo "replay: no recording for: $key" >&2
exit 1
