# Recorded Slurm answers for tests/snapshots.rs, one call per line:
#   <scenario glob> <exit code> <answer file or -> <command line glob>
# The first line matching $FAKE_SLURM_SCENARIO and the call wins. <file> goes to stdout
# (@TMP@ replaced by $FAKE_SLURM_TMP), <file>.err to stderr. "demo" is a busy made-up
# Allegro-like cluster (jobs of alice and bob), "plain" the same nodes without jobs.
demo-dev-start 0 - squeue -h --user=alice --format=%F --name=ab-dev
* 0 config scontrol show config
* 0 partitions scontrol --oneliner show partition
demo-* 0 demo-nodes.json scontrol --json show nodes
demo-* 0 demo-jobs.json scontrol --json show job
demo-* 0 job-70120.json scontrol --json show job 70120
demo-* 0 job-70122.json scontrol --json show job 70122
demo-* 1 job-999999 scontrol --json show job 999999
demo-* 0 demo-jobs.txt scontrol --oneliner --details show job
demo-* 0 job-70090.txt scontrol --oneliner --details show job 70090
demo-* 0 job-70110.txt scontrol --oneliner --details show job 70110
demo-* 0 job-70140.txt scontrol --oneliner --details show job 70140
demo-* 0 squeue-alice.txt squeue -h --format=%i|%A|%u|%j|%T|%P|%M|%L|%S|%R -u alice
demo-* 0 squeue-all.txt squeue -h --format=%i|%A|%u|%j|%T|%P|%M|%L|%S|%R
demo-* 0 dev-jobs.txt squeue -h --user=alice --format=%F --name=ab-dev
demo-* 0 sacct-alice.txt sacct --parsable2 --noheader -X --user=alice --starttime=now-30days --format=JobIDRaw,JobID,JobName,State,ExitCode,End,Reason
demo-* 0 sbatch.txt sbatch --parsable --job-name=ab-dev --partition=gpu --time=08:00:00 --mem=8G --output=*/home/slurm-output/ab-dev-%j.out --wrap=trap : TERM INT; sleep infinity & wait --cpus-per-gpu=2 --gres=gpu:1
demo-* 0 - scancel 70110
plain-* 0 plain-nodes.json scontrol --json show nodes
plain-* 0 sacctmgr-alice.txt sacctmgr -nP show user alice withassoc cluster=allegro format=DefaultAccount,Account,QOS
plain-* 0 - squeue -h --user=alice --format=%F
plain-* 0 reservations.txt scontrol --oneliner show reservation
